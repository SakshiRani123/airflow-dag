# ==============================================================================
# Environment Configuration Template for DHAP-34 (Airflow + PostgreSQL)
# Copy this file to .env before starting containers:
#   cp .env.example .env
# DO NOT commit .env with real credentials to source control!
# ==============================================================================

# Airflow UID (50000 is standard default for Apache Airflow official Docker image)
AIRFLOW_UID=50000

# PostgreSQL Target Database Settings
POSTGRES_DB=conversations_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me
POSTGRES_PORT=5432

# Airflow Webserver Admin Credentials
_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=airflow
